{
  "name": "ruc-web-helper",
  "version": "1.2.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "RUC Web Helper — 人大校园网助手",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "desktop:build:x64": "tauri build --no-bundle --target x86_64-pc-windows-msvc -- --locked",
    "test": "node --test tests/unit/*.test.mjs",
    "test:ui": "npm run build && node tests/e2e/smoke.cjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "icons": "node scripts/build-icons.cjs",
    "docs:screenshots": "npm run build && node scripts/capture-readme.cjs",
    "version:check": "node scripts/version.cjs --check",
    "version:set": "node scripts/version.cjs",
    "release:package": "pwsh -NoProfile -File scripts/package-release.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "playwright": "^1.64.0",
    "vite": "^7.0.0"
  }
}
